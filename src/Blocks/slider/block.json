{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "yard/slider",
	"version": "0.2.0",
	"title": "Slider",
	"category": "yard",
	"description": "Voeg slider toe.",
	"attributes": {
		"align": {
			"type": "string",
			"default": "wide"
		},
		"activeSlide": {
			"type": "string",
			"default": null
		}
	},
	"supports": {
		"align": [ "wide", "full" ],
		"contentRole": true,
		"html": false,
		"listView": true,
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"textdomain": "yard",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"render": "file:./render.php"
}
